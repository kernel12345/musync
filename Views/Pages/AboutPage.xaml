<Page x:Class="MuSync.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
    <StackPanel MaxWidth="760" Margin="12,8,12,20">

        <TextBlock Text="关于" Style="{StaticResource SettingsSectionHeader}" Margin="0,8,0,0" />

        <!-- ============ 应用信息 ============ -->
        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="AppIcon" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="16,4,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MuSync" FontSize="24" FontWeight="Bold" />
                        <TextBlock x:Name="VersionText" Margin="0,4,0,0" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="版本 --" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="把网易云音乐 / QQ 音乐 / 汽水音乐的播放状态同步到 Steam；支持自定义在线签名与游戏时长挂机。" />
                <TextBlock x:Name="RuntimeText" Margin="0,10,0,0" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="" />
            </StackPanel>
        </Border>

        <!-- ============ 链接 ============ -->
        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="项目地址" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Margin="0,8,0,0" FontSize="13">
                    <Hyperlink NavigateUri="https://github.com/kernel12345/musync"
                               RequestNavigate="Link_RequestNavigate">github.com/kernel12345/musync</Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,6,0,0" FontSize="13">
                    <Hyperlink NavigateUri="https://github.com/kernel12345/musync/releases"
                               RequestNavigate="Link_RequestNavigate">下载最新版本（Releases）</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ============ 版权 ============ -->
        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="版权与许可" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Copyright © 2026 MuSync contributors" />
                <TextBlock Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="本软件基于 MIT 许可证开源，允许自由使用、复制、修改、合并、发布、分发与再授权，但不提供任何明示或暗示的担保。完整许可证文本见仓库根目录 LICENSE。" />
            </StackPanel>
        </Border>

        <!-- ============ 开源致谢 ============ -->
        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="开源致谢" Style="{StaticResource SettingsCardTitle}" />
                <TextBlock Style="{StaticResource SettingsCardDescription}" Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Text="播放器状态读取与 Steam 同步的设计思路借鉴自以下开源项目，按各自许可证保留版权声明：" />

                <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="wuyan1337/yySync（MIT）" />
                <TextBlock FontSize="13">
                    <Hyperlink NavigateUri="https://github.com/wuyan1337/yySync"
                               RequestNavigate="Link_RequestNavigate">github.com/wuyan1337/yySync</Hyperlink>
                    <Run Text="  ·  Copyright (c) 2018 Kyle" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </TextBlock>

                <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="SteamKit2（LGPL-2.1）" />
                <TextBlock FontSize="13">
                    <Hyperlink NavigateUri="https://github.com/SteamRE/SteamKit"
                               RequestNavigate="Link_RequestNavigate">github.com/SteamRE/SteamKit</Hyperlink>
                </TextBlock>

                <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="WPF-UI（MIT）" />
                <TextBlock FontSize="13">
                    <Hyperlink NavigateUri="https://github.com/lepoco/wpfui"
                               RequestNavigate="Link_RequestNavigate">github.com/lepoco/wpfui</Hyperlink>
                    <Run Text="  ·  Copyright (c) 2021-2024 Leszek Pomianowski and WPF UI Contributors"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </TextBlock>

                <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="另使用 Microsoft.Win32.Registry、System.Security.Cryptography.ProtectedData 等 .NET 库（MIT）。完整声明见仓库 THIRD-PARTY-NOTICES.md。" />
            </StackPanel>
        </Border>

        <TextBlock Margin="4,2,4,0" FontSize="12"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="MuSync 为第三方开源工具，与 Valve / 网易云音乐 / 腾讯音乐 / 汽水音乐无官方关联；各产品名称与商标归其各自所有者所有。" />

    </StackPanel>
</Page>
