<Page x:Class="MuSync.LogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
    <!-- 高度绑定外层 ScrollContentPresenter 的可视区高度：整页不超过一屏，
         外层 DynamicScrollViewer 不再滚动，仅下方日志列表内部滚动，顶部工具栏固定 -->
    <Grid Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}">
        <Border Margin="12,8,12,12">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="History24" FontSize="18" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="运行日志" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="CountText" Text="" FontSize="12" Margin="12,0,0,2"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ComboBox x:Name="LevelFilter" Width="110" SelectedIndex="0" Margin="0,0,8,0">
                    <ComboBoxItem Content="全部" />
                    <ComboBoxItem Content="Info" />
                    <ComboBoxItem Content="警告" />
                    <ComboBoxItem Content="错误" />
                </ComboBox>
                <ui:Button x:Name="PauseButton" Content="暂停" Appearance="Secondary"
                           Icon="{ui:SymbolIcon Pause24}" Margin="0,0,8,0" Click="PauseButton_Click" />
                <ui:Button x:Name="AutoScrollButton" Content="自动滚动" Appearance="Secondary"
                           Icon="{ui:SymbolIcon ArrowCircleDown24}" Margin="0,0,8,0"
                           Click="AutoScrollButton_Click" />
                <ui:Button x:Name="CopyButton" Content="复制" Appearance="Secondary"
                           Icon="{ui:SymbolIcon Copy24}" Margin="0,0,8,0" Click="CopyButton_Click" />
                <ui:Button Content="清空" Appearance="Secondary"
                           Icon="{ui:SymbolIcon Delete24}" Margin="0,0,8,0" Click="ClearButton_Click" />
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon FolderOpen24}"
                           ToolTip="打开日志文件目录" Click="OpenFolderButton_Click" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Margin="2,6,0,8" FontSize="12"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="实时显示最近 1000 条内存日志（同时写入 %LocalAppData%\MuSync\logs\）；黑色/白色背景便于调试" />

        <Border Grid.Row="2" CornerRadius="8" BorderThickness="1"
                Background="#FF1E1E1E" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <ListBox x:Name="LogList" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas, Courier New"
                     FontSize="12.5"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,1" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextWrapping="NoWrap" Text="{Binding Line}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FFD4D4D4" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="WARN">
                                            <Setter Property="Foreground" Value="#FFD7BA7D" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                            <Setter Property="Foreground" Value="#FFF48771" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="INFO">
                                            <Setter Property="Foreground" Value="#FF9CDCFE" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        </Grid>
        </Border>
    </Grid>
</Page>
