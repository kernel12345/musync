<Page x:Class="MuSync.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
    <DockPanel>

        <!-- ==================== 顶部栏：标题居左，账户操作居右 ==================== -->
        <Grid DockPanel.Dock="Top" Margin="12,14,12,8">
            <TextBlock Text="设置" Style="{StaticResource SettingsSectionHeader}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:Button x:Name="LogoutButton" Content="退出登录" Margin="0,0,10,0" Click="LogoutButton_Click" />
                <ui:Button x:Name="LoginButton" Content="重新登录" Click="LoginButton_Click" />
            </StackPanel>
        </Grid>

        <StackPanel MaxWidth="760" Margin="12,0,12,20">

            <!-- ==================== 程序设置 ==================== -->
            <TextBlock Text="程序设置" Style="{StaticResource SettingsSectionHeader}" />
            <StackPanel>
                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Power24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="开机自启" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="随 Windows 登录自动启动 MuSync" Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="AutoStartToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Desktop24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="关闭窗口时隐藏到托盘" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="点击关闭按钮时不退出，最小化到系统托盘" Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="CloseToTrayToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Desktop24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="启动时隐藏到托盘" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="程序启动后不显示主窗口，仅驻留托盘" Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="StartInTrayToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ==================== Steam 显示设置 ==================== -->
            <TextBlock Text="Steam 显示设置" Style="{StaticResource SettingsSectionHeader}" />
            <StackPanel>
                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Chat24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="启用 Steam 同步" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="把正在播放的歌曲推送到 Steam 好友状态" Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="EnableSteamSyncToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="PaintBrush24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="自定义前缀" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="在歌曲信息前追加固定文字" Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:TextBox x:Name="CustomPrefixTextBox" Width="180" Margin="0,0,12,0"
                                        PlaceholderText="例如：正在听：" IsEnabled="False"
                                        TextChanged="TextBox_Changed" />
                            <ui:ToggleSwitch x:Name="EnableCustomPrefixToggle" VerticalAlignment="Center"
                                             Checked="Setting_Changed" Unchecked="Setting_Changed" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Chat24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="空闲/暂停时显示签名" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="未播放或暂停时，Steam 状态位显示自定义签名" Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:TextBox x:Name="CustomSignatureTextBox" Width="180" Margin="0,0,12,0"
                                        PlaceholderText="例如：摸鱼中，勿扰" IsEnabled="False"
                                        TextChanged="TextBox_Changed" />
                            <ui:ToggleSwitch x:Name="EnableCustomSignatureToggle" VerticalAlignment="Center"
                                             Checked="Setting_Changed" Unchecked="Setting_Changed" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Cursor24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="推送实时操作" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="未播放音乐时，把鼠标当前操作的应用名同步到 Steam 状态" Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="PushRealtimeActivityToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Person24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="显示歌手名称" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="歌曲名后附带歌手名" Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ShowArtistNameToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Play24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="显示进度条" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="▰▰▰▱▱▱ 2:30/4:15" Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ShowProgressBarToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Info24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="字数过多时优先显示" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="Steam 状态文本超长时保留哪部分" Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="PriorityArtistRadio" Content="歌手名称" Margin="0,0,12,0" GroupName="StatusPriority"
                                         Checked="Setting_Changed" />
                            <RadioButton x:Name="PriorityProgressRadio" Content="进度条" GroupName="StatusPriority"
                                         Checked="Setting_Changed" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Pause24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="玩游戏时自动暂停同步" Style="{StaticResource SettingsCardTitle}" />
                            <TextBlock Text="正在玩真实 Steam 游戏时，暂停音乐状态推送" Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="PauseWhenPlayingGameToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ==================== Steam 状态预览 ==================== -->
            <TextBlock Text="Steam 状态预览" Style="{StaticResource SettingsSectionHeader}" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Info24" Style="{StaticResource SettingsCardIcon}" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="好友看到" Style="{StaticResource SettingsCardTitle}" />
                        <TextBlock x:Name="PreviewText" Margin="0,4,0,0" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="🎵 稻香 - 周杰伦" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </DockPanel>
</Page>
